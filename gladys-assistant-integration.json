{
  "manifest_version": 1,
  "type": "device",
  "name": "Shodan",
  "description": {
    "en": "What the Internet sees of your home, by Shodan: open ports, vulnerabilities, alerts.",
    "fr": "Ce qu’Internet voit de votre maison, par Shodan : ports ouverts, vulnérabilités, alertes.",
    "de": "Was das Internet von deinem Zuhause sieht, per Shodan: offene Ports, Schwachstellen.",
    "es": "Lo que Internet ve de su casa, por Shodan: puertos abiertos, vulnerabilidades, alertas."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/william-de71/gladys-shodan:0.1.0",
  "gladys_version": ">=5.3.0",
  "categories": ["security", "servers"],
  "keywords": [
    "Shodan",
    "InternetDB",
    "CVE",
    "port scan",
    "scan de ports",
    "Portscan",
    "exposition",
    "vulnerability",
    "vulnérabilité",
    "IP publique"
  ],
  "cover_image": "https://raw.githubusercontent.com/William-De71/gladys-shodan/main/cover.jpg",
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "What the Internet sees",
        "fr": "Ce qu’Internet voit",
        "de": "Was das Internet sieht",
        "es": "Lo que Internet ve"
      },
      "description": {
        "en": "Shodan scans the whole Internet and lists the open ports and the software it finds. The integration asks Shodan what it knows of your public address: nothing is scanned from Gladys, and only the addresses go to Shodan. Without a key it uses InternetDB, free for non-commercial use and refreshed once a week. Not affiliated with Shodan.",
        "fr": "Shodan scanne tout Internet et recense les ports ouverts et les logiciels qu’il trouve. L’intégration demande à Shodan ce qu’il sait de votre adresse publique : rien n’est scanné depuis Gladys, et seules les adresses partent chez Shodan. Sans clé, elle utilise InternetDB, gratuit pour un usage non commercial et mis à jour une fois par semaine. Non affiliée à Shodan.",
        "de": "Shodan scannt das ganze Internet und listet offene Ports und gefundene Software auf. Die Integration fragt Shodan, was es über deine öffentliche Adresse weiß: Von Gladys aus wird nichts gescannt, nur die Adressen gehen an Shodan. Ohne Schlüssel nutzt sie InternetDB, kostenlos für nicht kommerzielle Nutzung und einmal pro Woche aktualisiert. Nicht mit Shodan verbunden.",
        "es": "Shodan escanea todo Internet y enumera los puertos abiertos y el software que encuentra. La integración pregunta a Shodan lo que sabe de su dirección pública: no se escanea nada desde Gladys y solo las direcciones van a Shodan. Sin clave usa InternetDB, gratuito para uso no comercial y actualizado una vez por semana. No afiliada a Shodan."
      },
      "links": [
        {
          "url": "https://internetdb.shodan.io",
          "label": {
            "en": "Shodan InternetDB",
            "fr": "Shodan InternetDB",
            "de": "Shodan InternetDB",
            "es": "Shodan InternetDB"
          }
        },
        {
          "url": "https://developer.shodan.io/api",
          "label": {
            "en": "Shodan API documentation",
            "fr": "Documentation de l’API Shodan",
            "de": "Dokumentation der Shodan-API",
            "es": "Documentación de la API de Shodan"
          }
        }
      ]
    },
    {
      "key": "monitor_public_ip",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Watch the public address of the home",
        "fr": "Surveiller l’adresse publique de la maison",
        "de": "Öffentliche Adresse des Zuhauses überwachen",
        "es": "Vigilar la dirección pública de la casa"
      },
      "description": {
        "en": "The address your Internet box uses, asked to Shodan every 15 minutes: it follows a change of address.",
        "fr": "L’adresse de votre box Internet, demandée à Shodan toutes les 15 minutes : elle suit un changement d’adresse.",
        "de": "Die Adresse deines Internet-Routers, alle 15 Minuten bei Shodan erfragt: Sie folgt einem Adresswechsel.",
        "es": "La dirección de su router de Internet, consultada a Shodan cada 15 minutos: sigue un cambio de dirección."
      }
    },
    {
      "key": "addresses",
      "type": "string",
      "required": false,
      "label": {
        "en": "Other addresses",
        "fr": "Autres adresses",
        "de": "Weitere Adressen",
        "es": "Otras direcciones"
      },
      "description": {
        "en": "Public IP addresses or host names (a dynamic DNS name, a server), separated by commas, 10 at most. Watch only addresses that are yours.",
        "fr": "Adresses IP publiques ou noms d’hôte (un nom DNS dynamique, un serveur), séparés par des virgules, 10 au maximum. Ne surveillez que vos propres adresses.",
        "de": "Öffentliche IP-Adressen oder Hostnamen (ein DynDNS-Name, ein Server), durch Kommas getrennt, höchstens 10. Überwache nur eigene Adressen.",
        "es": "Direcciones IP públicas o nombres de host (un nombre DNS dinámico, un servidor), separados por comas, 10 como máximo. Vigile solo sus propias direcciones."
      },
      "placeholder": {
        "en": "home.example.org, 203.0.113.7",
        "fr": "maison.example.org, 203.0.113.7",
        "de": "zuhause.example.org, 203.0.113.7",
        "es": "casa.example.org, 203.0.113.7"
      }
    },
    {
      "key": "key_section",
      "type": "section",
      "label": {
        "en": "Shodan API key (optional)",
        "fr": "Clé API Shodan (facultative)",
        "de": "Shodan-API-Schlüssel (optional)",
        "es": "Clave API de Shodan (opcional)"
      },
      "description": {
        "en": "With the key of a Shodan account (account.shodan.io), the integration reads the Shodan API instead: the software and version of each service, the CVSS scores, the date of the last scan, the credits, and the on-demand scan (paid plans). Without a key everything else works.",
        "fr": "Avec la clé d’un compte Shodan (account.shodan.io), l’intégration lit l’API Shodan à la place : logiciel et version de chaque service, scores CVSS, date du dernier scan, crédits, et scan à la demande (offres payantes). Sans clé, tout le reste fonctionne.",
        "de": "Mit dem Schlüssel eines Shodan-Kontos (account.shodan.io) liest die Integration stattdessen die Shodan-API: Software und Version jedes Dienstes, CVSS-Werte, Datum des letzten Scans, Credits und Scan auf Anfrage (Bezahltarife). Ohne Schlüssel funktioniert alles andere.",
        "es": "Con la clave de una cuenta Shodan (account.shodan.io), la integración lee la API de Shodan en su lugar: software y versión de cada servicio, puntuaciones CVSS, fecha del último escaneo, créditos y escaneo a demanda (planes de pago). Sin clave, todo lo demás funciona."
      },
      "links": [
        {
          "url": "https://account.shodan.io",
          "label": {
            "en": "Your Shodan account",
            "fr": "Votre compte Shodan",
            "de": "Dein Shodan-Konto",
            "es": "Su cuenta Shodan"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "required": false,
      "label": {
        "en": "API key",
        "fr": "Clé API",
        "de": "API-Schlüssel",
        "es": "Clave API"
      },
      "placeholder": {
        "en": "The key shown on account.shodan.io",
        "fr": "La clé affichée sur account.shodan.io",
        "de": "Der auf account.shodan.io angezeigte Schlüssel",
        "es": "La clave que aparece en account.shodan.io"
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "auto",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names, scene texts and errors. Automatic: the language of the last widget shown.",
        "fr": "Noms des fonctionnalités, textes des scènes et erreurs. Automatique : la langue du dernier widget affiché.",
        "de": "Namen der Funktionen, Szenentexte und Fehler. Automatisch: die Sprache des zuletzt angezeigten Widgets.",
        "es": "Nombres de las funciones, textos de escenas y errores. Automático: el idioma del último widget mostrado."
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic",
            "fr": "Automatique",
            "de": "Automatisch",
            "es": "Automático"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "English",
            "de": "English",
            "es": "English"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "Français",
            "fr": "Français",
            "de": "Français",
            "es": "Français"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "Deutsch",
            "fr": "Deutsch",
            "de": "Deutsch",
            "es": "Deutsch"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Español",
            "fr": "Español",
            "de": "Español",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 90,
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Asks the public address, reads every address and the key now.",
        "fr": "Demande l’adresse publique, lit toutes les adresses et la clé maintenant.",
        "de": "Fragt die öffentliche Adresse ab, liest alle Adressen und den Schlüssel jetzt.",
        "es": "Consulta la dirección pública, lee todas las direcciones y la clave ahora."
      }
    },
    {
      "key": "diagnostic",
      "timeout_seconds": 10,
      "label": {
        "en": "Diagnostic",
        "fr": "Diagnostic",
        "de": "Diagnose",
        "es": "Diagnóstico"
      },
      "description": {
        "en": "Writes what the integration knows to its logs (never the key), for an issue.",
        "fr": "Écrit ce que sait l’intégration dans ses journaux (jamais la clé), pour un ticket.",
        "de": "Schreibt, was die Integration weiß, in ihre Logs (nie den Schlüssel), für ein Ticket.",
        "es": "Escribe lo que sabe la integración en sus registros (nunca la clave), para una incidencia."
      }
    }
  ],
